{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://yourapp.com/schemas/presentation-contract-v2.json",
  "title": "Presentation Contract v2",
  "description": "Master data contract for the AI PPTX pipeline. Generated by Phase 1 (Brain), consumed by Phase 2 (Designer) and Phase 3 (Compiler).",
  "type": "object",

  "required": ["meta", "theme", "slides"],

  "properties": {

    "meta": {
      "type": "object",
      "description": "Top-level presentation metadata. Set once, used by all phases.",
      "required": ["id", "title", "subject", "grade_level", "duration_minutes", "slide_count", "language", "board", "purpose", "generated_at"],
      "properties": {
        "id":               { "type": "string", "description": "UUID for this generation job", "example": "a3f8c1d2-7b44-4e9a-bc12-0f3d9a8e1234" },
        "title":            { "type": "string", "description": "Presentation title shown on Hero slide", "example": "Photosynthesis: How Plants Make Food" },
        "subject":          { "type": "string", "enum": ["science", "math", "history", "english", "geography", "computer_science", "social_studies", "art", "physical_education", "other"] },
        "grade_level":      { "type": "string", "description": "Grade band", "enum": ["primary_1_5", "middle_6_8", "secondary_9_10", "senior_11_12", "college"] },
        "duration_minutes": { "type": "integer", "minimum": 5, "maximum": 120, "example": 30 },
        "slide_count":      { "type": "integer", "minimum": 4, "maximum": 25 },
        "language":         { "type": "string", "example": "en" },
        "board":            { "type": "string", "description": "Curriculum board", "enum": ["CBSE", "ICSE", "State", "IB", "Cambridge", "Common_Core", "Other"] },
        "purpose":          { "type": "string", "description": "Why this lesson exists", "enum": ["introduce_new_topic", "revision", "exam_prep", "activity_workshop", "flipped_classroom"] },
        "teacher_name":     { "type": "string", "example": "Ms. Priya Sharma" },
        "school_name":      { "type": "string", "example": "Delhi Public School" },
        "generated_at":     { "type": "string", "format": "date-time" },
        "pipeline_version": { "type": "string", "example": "2.0.0" }
      }
    },

    "theme": {
      "type": "object",
      "description": "Visual identity. Injected as CSS vars in Phase 2, converted to OOXML theme in Phase 3.",
      "required": ["name", "colors", "fonts"],
      "properties": {
        "name": { "type": "string", "example": "science_blue" },
        "colors": {
          "type": "object",
          "required": ["primary", "secondary", "accent", "background", "text_dark", "text_light", "surface"],
          "properties": {
            "primary":    { "type": "string", "description": "Dominant brand color", "example": "#1A6FA8" },
            "secondary":  { "type": "string", "example": "#0D9E75" },
            "accent":     { "type": "string", "description": "High-contrast pop color for callouts/highlights", "example": "#F4A623" },
            "background": { "type": "string", "description": "Slide background color", "example": "#F7F9FC" },
            "text_dark":  { "type": "string", "example": "#1A1A2E" },
            "text_light": { "type": "string", "example": "#FFFFFF" },
            "surface":    { "type": "string", "description": "Card/box background color", "example": "#FFFFFF" }
          }
        },
        "fonts": {
          "type": "object",
          "required": ["heading", "body", "mono"],
          "properties": {
            "heading": { "type": "string", "description": "Display font for titles", "example": "Montserrat" },
            "body":    { "type": "string", "description": "Readable body font", "example": "Open Sans" },
            "mono":    { "type": "string", "description": "Monospace for code/data", "example": "Fira Code" }
          }
        },
        "logo_url": {
          "type": ["string", "null"],
          "description": "School logo URL. Null if not provided. Placed in corner of every slide.",
          "example": "https://cdn.school.com/logo.png"
        }
      }
    },

    "slides": {
      "type": "array",
      "description": "Ordered array of slide objects. Each slide is fully self-contained.",
      "minItems": 4,
      "maxItems": 25,
      "items": { "$ref": "#/definitions/slide" }
    }
  },

  "definitions": {

    "slide": {
      "type": "object",
      "required": ["slide_number", "template_type", "content"],
      "properties": {

        "slide_number": {
          "type": "integer",
          "minimum": 1,
          "description": "1-based index. Determines render + compile order."
        },

        "template_type": {
          "type": "string",
          "description": "Which of the 12 HTML templates Phase 2 should load for this slide.",
          "enum": [
            "hero",
            "learning_objectives",
            "hook",
            "content_single",
            "content_three_col",
            "visual_diagram",
            "timeline",
            "comparison_table",
            "real_world_example",
            "activity",
            "quiz_mcq",
            "summary"
          ]
        },

        "bloom_level": {
          "type": "string",
          "description": "Bloom's Taxonomy level this slide targets. Drives template variant selection.",
          "enum": ["remember", "understand", "apply", "analyze", "evaluate", "create"]
        },

        "curriculum_tag": {
          "type": ["string", "null"],
          "description": "Curriculum learning outcome code this slide satisfies.",
          "example": "CBSE-Sci-7-Ch1-LO3"
        },

        "transition": {
          "type": "string",
          "description": "PowerPoint transition type for this slide.",
          "enum": ["none", "fade", "push", "wipe", "morph"],
          "default": "fade"
        },

        "animation_hint": {
          "type": "string",
          "description": "Instruction for Phase 2 headless renderer about animation state to capture.",
          "enum": ["static", "entrance_stagger", "click_reveal", "timeline_build"],
          "default": "static"
        },

        "speaker_notes": {
          "type": "string",
          "description": "Full teacher script for this slide. Written by the Researcher agent. Injected into PPTX notes pane by Phase 3.",
          "example": "Start by asking students if they have ever seen leaves change color in autumn. That connects to today's topic. Give them 30 seconds to think before answering."
        },

        "accessibility": {
          "type": "object",
          "description": "Accessibility metadata. Phase 3 writes this into PPTX alt text XML.",
          "properties": {
            "slide_title_sr": {
              "type": "string",
              "description": "Screen-reader-only slide title (if visual title is decorative)",
              "example": "Slide 4: The Light-Dependent Reactions"
            },
            "reading_order": {
              "type": "array",
              "description": "Element IDs in the order a screen reader should announce them.",
              "items": { "type": "string" },
              "example": ["headline", "subheadline", "bullet_1", "bullet_2", "image"]
            }
          }
        },

        "content": {
          "type": "object",
          "description": "Slide content payload. Shape depends on template_type.",
          "oneOf": [
            { "$ref": "#/definitions/content_hero" },
            { "$ref": "#/definitions/content_objectives" },
            { "$ref": "#/definitions/content_hook" },
            { "$ref": "#/definitions/content_single" },
            { "$ref": "#/definitions/content_three_col" },
            { "$ref": "#/definitions/content_diagram" },
            { "$ref": "#/definitions/content_timeline" },
            { "$ref": "#/definitions/content_comparison" },
            { "$ref": "#/definitions/content_example" },
            { "$ref": "#/definitions/content_activity" },
            { "$ref": "#/definitions/content_quiz_mcq" },
            { "$ref": "#/definitions/content_summary" }
          ]
        }
      }
    },

    "image_spec": {
      "type": "object",
      "description": "Reusable image request spec. Phase 2 fetches + crops. Phase 3 embeds.",
      "required": ["query"],
      "properties": {
        "query":          { "type": "string", "description": "Natural language Unsplash/AI search query", "example": "green leaves sunlight macro photography" },
        "placement":      { "type": "string", "enum": ["full_background", "right_half", "left_half", "inset_card", "inline"], "default": "right_half" },
        "crop_focus":     { "type": "string", "description": "Where to focus the smart crop", "enum": ["center", "top", "bottom", "face", "auto"], "default": "auto" },
        "alt_text":       { "type": "string", "description": "Alt text for accessibility", "example": "Close-up of green leaves in sunlight illustrating photosynthesis" },
        "overlay_opacity":{ "type": "number", "minimum": 0, "maximum": 1, "description": "Dark overlay on background images for text legibility", "default": 0.4 },
        "source":         { "type": "string", "enum": ["unsplash", "ai_generated", "teacher_upload", "none"], "default": "unsplash" }
      }
    },

    "chart_spec": {
      "type": "object",
      "description": "Chart data for visual_diagram slides. Phase 2 renders via Chart.js. Phase 3 embeds as native PPTX chart object.",
      "required": ["chart_type", "labels", "datasets"],
      "properties": {
        "chart_type": { "type": "string", "enum": ["bar", "line", "pie", "donut", "scatter", "area"] },
        "title":      { "type": "string", "example": "CO2 Absorbed by Different Plant Types (kg/year)" },
        "labels":     { "type": "array", "items": { "type": "string" }, "example": ["Oak", "Pine", "Fern", "Cactus"] },
        "datasets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "data"],
            "properties": {
              "label": { "type": "string" },
              "data":  { "type": "array", "items": { "type": "number" } },
              "color": { "type": "string", "description": "Hex color for this dataset series" }
            }
          }
        },
        "x_axis_label": { "type": "string" },
        "y_axis_label": { "type": "string" },
        "show_legend":  { "type": "boolean", "default": true }
      }
    },

    "content_hero": {
      "type": "object",
      "description": "Template: hero. Full-bleed background image with title overlay.",
      "required": ["headline"],
      "properties": {
        "headline":     { "type": "string", "maxLength": 80, "example": "Photosynthesis" },
        "subheadline":  { "type": "string", "maxLength": 120, "example": "How Plants Convert Sunlight Into Energy" },
        "teacher_name": { "type": "string" },
        "class_info":   { "type": "string", "example": "Class 7 · Biology · 30 min" },
        "image":        { "$ref": "#/definitions/image_spec" }
      }
    },

    "content_objectives": {
      "type": "object",
      "description": "Template: learning_objectives. Checklist layout with action-verb bullets.",
      "required": ["headline", "objectives"],
      "properties": {
        "headline":   { "type": "string", "default": "Learning Objectives" },
        "intro_line": { "type": "string", "description": "Optional sentence before the list", "example": "By the end of this lesson, you will be able to:" },
        "objectives": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["verb", "text"],
            "properties": {
              "verb": { "type": "string", "description": "Bloom's action verb", "example": "Explain" },
              "text": { "type": "string", "example": "the process of light-dependent reactions" },
              "bloom_level": { "type": "string" }
            }
          }
        },
        "image": { "$ref": "#/definitions/image_spec" }
      }
    },

    "content_hook": {
      "type": "object",
      "description": "Template: hook. Big attention-grabbing statement with one supporting image.",
      "required": ["hook_type", "hook_text"],
      "properties": {
        "hook_type":   { "type": "string", "enum": ["question", "fact", "statistic", "quote", "myth_vs_truth", "story_opener"] },
        "hook_text":   { "type": "string", "maxLength": 200, "example": "A single large oak tree absorbs 48 pounds of CO2 every single year. How?" },
        "source":      { "type": ["string", "null"], "description": "Citation for stat/quote", "example": "US Forest Service, 2022" },
        "prompt_text": { "type": "string", "description": "Discussion question to pose to students", "example": "Think about: where do plants get their energy from?" },
        "image":       { "$ref": "#/definitions/image_spec" }
      }
    },

    "content_single": {
      "type": "object",
      "description": "Template: content_single. One main concept, max 3 bullet points.",
      "required": ["headline", "bullets"],
      "properties": {
        "headline":    { "type": "string", "maxLength": 80 },
        "subheadline": { "type": "string", "maxLength": 100 },
        "bullets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["text"],
            "properties": {
              "text":        { "type": "string", "maxLength": 120, "description": "Keep to a single key idea — never a paragraph" },
              "sub_bullets": { "type": "array", "maxItems": 2, "items": { "type": "string" } },
              "emphasis":    { "type": "boolean", "description": "If true, Phase 2 renders this bullet in accent color", "default": false }
            }
          }
        },
        "callout": {
          "type": "object",
          "description": "Optional highlighted box for a key term or formula",
          "properties": {
            "label":   { "type": "string", "example": "Key Term" },
            "content": { "type": "string", "example": "Chlorophyll — the green pigment that absorbs sunlight" }
          }
        },
        "image": { "$ref": "#/definitions/image_spec" }
      }
    },

    "content_three_col": {
      "type": "object",
      "description": "Template: content_three_col. Three equal columns for parallel concepts.",
      "required": ["headline", "columns"],
      "properties": {
        "headline": { "type": "string" },
        "columns": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["title", "points"],
            "properties": {
              "icon":   { "type": "string", "description": "Unicode emoji or icon name", "example": "☀️" },
              "title":  { "type": "string", "maxLength": 40 },
              "points": { "type": "array", "maxItems": 4, "items": { "type": "string", "maxLength": 80 } },
              "color_variant": { "type": "string", "enum": ["primary", "secondary", "accent"], "default": "primary" }
            }
          }
        }
      }
    },

    "content_diagram": {
      "type": "object",
      "description": "Template: visual_diagram. Renders a chart OR a labeled diagram image.",
      "required": ["headline", "diagram_type"],
      "properties": {
        "headline":     { "type": "string" },
        "diagram_type": { "type": "string", "enum": ["chart", "labeled_image", "process_flow", "concept_map"] },
        "chart":        { "$ref": "#/definitions/chart_spec" },
        "labeled_image": {
          "type": "object",
          "description": "For diagram_type: labeled_image. Phase 2 fetches the image and overlays labels.",
          "properties": {
            "image":  { "$ref": "#/definitions/image_spec" },
            "labels": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["text", "position_x_pct", "position_y_pct"],
                "properties": {
                  "text":           { "type": "string" },
                  "position_x_pct": { "type": "number", "minimum": 0, "maximum": 100, "description": "X position as % of slide width" },
                  "position_y_pct": { "type": "number", "minimum": 0, "maximum": 100, "description": "Y position as % of slide height" }
                }
              }
            }
          }
        },
        "caption": { "type": "string", "description": "Caption text below the diagram" }
      }
    },

    "content_timeline": {
      "type": "object",
      "description": "Template: timeline. Horizontal or vertical timeline of events.",
      "required": ["headline", "events"],
      "properties": {
        "headline":   { "type": "string" },
        "orientation":{ "type": "string", "enum": ["horizontal", "vertical"], "default": "horizontal" },
        "events": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": ["label", "title"],
            "properties": {
              "label":       { "type": "string", "description": "Date, step number, or year", "example": "1804" },
              "title":       { "type": "string", "maxLength": 60 },
              "description": { "type": "string", "maxLength": 120 },
              "highlight":   { "type": "boolean", "description": "Mark as the key/climax event", "default": false }
            }
          }
        }
      }
    },

    "content_comparison": {
      "type": "object",
      "description": "Template: comparison_table. Side-by-side comparison of 2 or 3 items.",
      "required": ["headline", "items", "criteria"],
      "properties": {
        "headline": { "type": "string" },
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name":      { "type": "string" },
              "icon":      { "type": "string" },
              "highlight": { "type": "boolean", "description": "Mark as preferred/winner column", "default": false }
            }
          }
        },
        "criteria": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": ["label", "values"],
            "properties": {
              "label":  { "type": "string", "example": "Needs Sunlight" },
              "values": {
                "type": "array",
                "description": "One value per item in the same order as 'items' array",
                "items": { "type": "string" },
                "example": ["Yes", "No", "Partial"]
              }
            }
          }
        }
      }
    },

    "content_example": {
      "type": "object",
      "description": "Template: real_world_example. Connects concept to student's daily life.",
      "required": ["headline", "connection_text", "example_text"],
      "properties": {
        "headline":        { "type": "string", "example": "You See This Every Day" },
        "connection_text": { "type": "string", "description": "Short bridge sentence", "example": "Photosynthesis is why your food exists." },
        "example_text":    { "type": "string", "maxLength": 300, "description": "The relatable scenario", "example": "Every grain of rice, every vegetable, and every fruit you eat exists because a plant somewhere absorbed sunlight and turned it into sugar." },
        "follow_up":       { "type": "string", "description": "Question to ask students", "example": "Can you name 3 things in your lunch box that exist because of photosynthesis?" },
        "image":           { "$ref": "#/definitions/image_spec" }
      }
    },

    "content_activity": {
      "type": "object",
      "description": "Template: activity. Student engagement slide with clear instructions.",
      "required": ["headline", "activity_type", "instructions"],
      "properties": {
        "headline":      { "type": "string", "example": "Quick Activity — 5 Minutes" },
        "activity_type": { "type": "string", "enum": ["think_pair_share", "quick_write", "draw_and_label", "solve_problem", "true_false_vote", "group_discussion", "mini_experiment"] },
        "duration_min":  { "type": "integer", "minimum": 1, "maximum": 15 },
        "instructions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": { "type": "string" },
          "example": ["Draw a simple leaf diagram", "Label: sunlight, CO2, water, glucose, oxygen", "Circle the part where photosynthesis happens"]
        },
        "materials": {
          "type": "array",
          "description": "What students need (paper, calculator, etc.)",
          "items": { "type": "string" }
        }
      }
    },

    "content_quiz_mcq": {
      "type": "object",
      "description": "Template: quiz_mcq. Multiple choice quiz with 3–5 questions.",
      "required": ["headline", "questions"],
      "properties": {
        "headline":     { "type": "string", "default": "Quick Check — What Did You Learn?" },
        "reveal_mode":  { "type": "string", "description": "How answers are revealed", "enum": ["teacher_click", "auto_highlight", "hidden_for_print"], "default": "teacher_click" },
        "questions": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["question_text", "options", "correct_index"],
            "properties": {
              "question_text": { "type": "string" },
              "options": {
                "type": "array",
                "minItems": 3,
                "maxItems": 4,
                "items": { "type": "string" }
              },
              "correct_index": { "type": "integer", "description": "0-based index of the correct option", "minimum": 0, "maximum": 3 },
              "explanation":   { "type": "string", "description": "Why this answer is correct. Shown after reveal.", "example": "Chlorophyll absorbs light energy and uses it to convert CO2 and water into glucose." },
              "bloom_level":   { "type": "string" }
            }
          }
        }
      }
    },

    "content_summary": {
      "type": "object",
      "description": "Template: summary. Recap of the 3–5 biggest ideas from the lesson.",
      "required": ["headline", "takeaways"],
      "properties": {
        "headline": { "type": "string", "default": "Key Takeaways" },
        "takeaways": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["number", "text"],
            "properties": {
              "number": { "type": "integer" },
              "text":   { "type": "string", "maxLength": 120 }
            }
          }
        },
        "closing_question": { "type": "string", "description": "One final thought-provoking question", "example": "Where else in nature do you think photosynthesis plays a hidden role?" },
        "next_lesson":      { "type": "string", "description": "Preview of the next class", "example": "Next class: The Calvin Cycle — what plants do with the glucose they make." },
        "homework":         { "type": ["string", "null"], "example": "Read Chapter 4, pages 82–89. Identify 3 adaptations plants have for better photosynthesis." }
      }
    }
  },

  "example": {
    "meta": {
      "id": "a3f8c1d2-7b44-4e9a-bc12-0f3d9a8e1234",
      "title": "Photosynthesis: How Plants Make Food",
      "subject": "science",
      "grade_level": "middle_6_8",
      "duration_minutes": 30,
      "slide_count": 11,
      "language": "en",
      "board": "CBSE",
      "purpose": "introduce_new_topic",
      "teacher_name": "Ms. Priya Sharma",
      "school_name": "Delhi Public School",
      "generated_at": "2025-06-01T09:00:00Z",
      "pipeline_version": "2.0.0"
    },
    "theme": {
      "name": "science_blue",
      "colors": {
        "primary":    "#1A6FA8",
        "secondary":  "#0D9E75",
        "accent":     "#F4A623",
        "background": "#F7F9FC",
        "text_dark":  "#1A1A2E",
        "text_light": "#FFFFFF",
        "surface":    "#FFFFFF"
      },
      "fonts": {
        "heading": "Montserrat",
        "body":    "Open Sans",
        "mono":    "Fira Code"
      },
      "logo_url": null
    },
    "slides": [
      {
        "slide_number": 1,
        "template_type": "hero",
        "bloom_level": "remember",
        "curriculum_tag": null,
        "transition": "fade",
        "animation_hint": "static",
        "speaker_notes": "Welcome students. Ask them to look at the image and guess today's topic before reading the title.",
        "accessibility": {
          "slide_title_sr": "Slide 1: Title — Photosynthesis: How Plants Make Food",
          "reading_order": ["headline", "subheadline", "class_info"]
        },
        "content": {
          "headline":     "Photosynthesis",
          "subheadline":  "How Plants Convert Sunlight Into Energy",
          "teacher_name": "Ms. Priya Sharma",
          "class_info":   "Class 7 · Biology · 30 min",
          "image": {
            "query":           "green leaves sunlight forest macro",
            "placement":       "full_background",
            "crop_focus":      "center",
            "alt_text":        "Sunlight filtering through green forest leaves",
            "overlay_opacity": 0.5,
            "source":          "unsplash"
          }
        }
      },
      {
        "slide_number": 2,
        "template_type": "learning_objectives",
        "bloom_level": "understand",
        "curriculum_tag": "CBSE-Sci-7-Ch1-LO1",
        "transition": "fade",
        "animation_hint": "entrance_stagger",
        "speaker_notes": "Read each objective aloud with students. Ask them which one they think will be hardest.",
        "accessibility": {
          "slide_title_sr": "Slide 2: Learning Objectives",
          "reading_order": ["headline", "intro_line", "obj_1", "obj_2", "obj_3"]
        },
